# API/Prisma configuration. Replace YOUR_URL_ENCODED_PASSWORD in api/.env.
DATABASE_URL="postgresql://postgres:YOUR_URL_ENCODED_PASSWORD@localhost:5432/pg_management?schema=public"

# API
API_PORT=4000
NODE_ENV=development
WEB_ORIGIN=http://localhost:5173

# Web app (copy this setting to the repository-root .env; Vite exposes VITE_ values to browser code)
VITE_API_BASE_URL=http://localhost:4000/api/v1
